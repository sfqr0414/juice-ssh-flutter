# =====================================================================
# 本项目：只跟踪源码，不跟踪中间产物、缓存与取证材料
# =====================================================================

# 分发件（构建出来的 APK）
/dist/

# Android 构建缓存与本地配置、签名材料
/android/.gradle/
/android/local.properties
/android/key.properties
*.jks
*.keystore

# Windows 桌面端脚手架产物（Flutter 生成）
/windows/flutter/ephemeral/

# 取证与验证材料：截图、uiautomator dump、原版数据库只读副本、
# **测试用 SSH 私钥**（无论如何都不应入库）
/.research/

# 原版参考 APK（第三方二进制，体积大，不入库）
/reference/

# 临时文件
*.tmp
android/build/
